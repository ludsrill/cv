{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "@/*": [
      "src/*"
    ],
    "@cv": [
      "./cv.json"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}