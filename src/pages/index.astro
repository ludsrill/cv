---
import Layout from "../layouts/Layout.astro";

import Experience from "src/components/sections/Experience.astro";
import About from "src/components/sections/About.astro";
import Education from "src/components/sections/Education.astro";
import Hero from "src/components/sections/Hero.astro";
import Skills from "src/components/sections/Skills.astro";
import Projects from "src/components/sections/Projects.astro";
import KeyboardManager from "src/components/KeyboardManager.astro";
import Certificates from "src/components/sections/Certificates.astro";
---

<Layout title="Ludsrill">
	<main>
		<Hero />
		<About />
		<Experience />
		<Skills />
		<Education />
		<Certificates />
		<Projects />
		<KeyboardManager />
	</main>
</Layout>

<style>
	main {
		padding: 20px;
		margin: auto;
		width: 100%;
	}

	@media (min-width: 800px) {
		main {
			padding: 4rem;
			margin: auto;
			width: 100%;
		}
	}
</style>
