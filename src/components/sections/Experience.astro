---
import Section from "../Section.astro";
import { work } from "cv.json";
---

<Section title="Work Experience">
  <ul>
    {
      work.map(
        ({ name, position, startDate, endDate, summary, highlights }) => {
          const startYear = new Date(startDate).getFullYear();
          const endYear =
            endDate !== null ? new Date(endDate).getFullYear() : "Present";
          const years = `${startYear} - ${endYear}`;
          return (
            <li>
              <article>
                <header>
                  <div>
                    <h3>{name}</h3>
                    <h4>{position}</h4>
                  </div>
                  <time>{years}</time>
                </header>
                <body>
                  <p>{summary}</p>
                  <li>
                    {highlights.map((highlight) => {
                      return <ul>{highlight}</ul>;
                    })}
                  </li>
                </body>
              </article>
            </li>
          );
        },
      )
    }
  </ul>
</Section>
<style>
  ul {
    list-style-type: none;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  body p {
    color: #d9d9d9;
    font-size: 0.75rem;
    display: flex;
    flex-direction: column;
    margin-top: 5px;
  }
  article ul {
    color: #d9d9d9;
    font-size: 0.75rem;
    list-style-type: none;
    display: flex;
    flex-direction: column;
    margin-bottom: 5px;
  }

  article h3 {
    font-weight: 500;
  }

  article h4 {
    font-weight: 500;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }
  time {
    font-size: 0.85rem;
  }
</style>
