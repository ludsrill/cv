---
import Section from "../Section.astro";
import { education } from "cv.json";
---

<Section title="Education">
  <ul>
    {
      education.map(
        ({ institution, area, studyType, startDate, endDate, courses }) => {
          const startYear = new Date(startDate).getFullYear();
          const endYear =
            endDate !== null ? new Date(endDate).getFullYear() : "Present";
          const years = `${startYear} - ${endYear}`;
          return (
            <li>
              <article>
                <header>
                  <div>
                    <h3>{institution}</h3>
                    <h4>{area}</h4>
                  </div>
                  <time>{years}</time>
                </header>
              </article>
            </li>
          );
        },
      )
    }
  </ul>
</Section>
<style>
  ul {
    list-style-type: none;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  article h3 {
    font-weight: 500;
  }

  article h4 {
    font-weight: 400;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }
  time {
    font-size: 0.85rem;
  }
</style>
